<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Notepad</title>

<style>

* {
    box-sizing: border-box;
}

:root {
    --bg: #ffffff;
    --panel: #f3f3f3;
    --text: #000000;
    --secondary: #555555;
    --border: #000000;
    --input-bg: #000000;
    --input-text: #ffffff;
    --card: #f2f2f2;
    --button: #000000;
    --button-text: #ffffff;
    --notebook: #ffffff;
    --line: #cccccc;
}

body.dark {
    --bg: #111111;
    --panel: #1c1c1c;
    --text: #ffffff;
    --secondary: #bbbbbb;
    --border: #ffffff;
    --input-bg: #ffffff;
    --input-text: #000000;
    --card: #242424;
    --button: #ffffff;
    --button-text: #000000;
    --notebook: #eeeeee;
    --line: #999999;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
    transition: background 0.3s ease, color 0.3s ease;
}

.app {
    min-height: 100vh;
    display: flex;
}


/* THEME BUTTON */

.theme-button {
    position: fixed;
    top: 20px;
    right: 25px;
    z-index: 100;
    border: 2px solid var(--border);
    background: var(--button);
    color: var(--button-text);
    padding: 10px 16px;
    border-radius: 25px;
    cursor: pointer;
    font-size: 15px;
    font-weight: bold;
}

.theme-button:hover {
    opacity: 0.8;
}

/* SAVE INDICATOR */

.save-indicator {
    position: fixed;
    top: 75px;
    right: 25px;
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 12px;
    background: var(--card);
    color: var(--text);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 99;
}

.save-indicator.show {
    opacity: 1;
}

/* LEFT PANEL */

.left-panel {
    width: 50%;
    min-height: 100vh;
    padding: 50px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-right: 2px solid var(--border);
    background: var(--bg);
}

h1 {
    font-size: 48px;
    margin: 0 0 10px;
}

.subtitle {
    font-size: 18px;
    margin: 0 0 35px;
    text-align: center;
    color: var(--secondary);
}


/* PHOTO */

.photo-section {
    text-align: center;
    margin-bottom: 25px;
}

.photo-placeholder {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background: var(--card);
    border: 2px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 50px;
    margin: auto;
}

.photo-preview {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    border: 2px solid var(--border);
    object-fit: cover;
    display: none;
    margin: auto;
}

.upload-photo {
    display: inline-block;
    margin-top: 15px;
    cursor: pointer;
    font-weight: bold;
}

#photoInput {
    display: none;
}


/* NAME INPUT */

.name-input {
    width: 100%;
    max-width: 500px;
    padding: 16px;
    background: var(--input-bg);
    color: var(--input-text);
    border: 2px solid var(--border);
    border-radius: 6px;
    font-size: 17px;
    outline: none;
}

.name-input::placeholder {
    color: var(--input-text);
    opacity: 0.7;
}


/* DOCUMENT UPLOAD */

.document-upload {
    width: 100%;
    max-width: 500px;
    margin-top: 25px;
    border: 2px dashed var(--border);
    border-radius: 8px;
    padding: 25px;
    text-align: center;
}

#documentInput {
    display: none;
}

.document-label {
    cursor: pointer;
    font-weight: bold;
}

.documents {
    margin-top: 15px;
    width: 100%;
}

.document-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px;
    margin-top: 8px;
    background: var(--card);
    border-radius: 5px;
}

.document-item button {
    background: var(--button);
    color: var(--button-text);
    border: none;
    padding: 6px 10px;
    border-radius: 4px;
    cursor: pointer;
}


/* VISUAL PANEL */

.visual-panel {
    width: 50%;
    min-height: 100vh;
    background: var(--panel);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.visual-content {
    width: 100%;
    text-align: center;
}

.visual-content h2 {
    font-size: 32px;
    margin: 20px 0 8px;
}

.visual-content p {
    font-size: 17px;
    color: var(--secondary);
}


/* NOTEBOOK AREA */

.notebook-area {
    width: 500px;
    height: 430px;
    position: relative;
    margin: auto;
}


/* NOTEBOOK */

.notebook {
    position: absolute;
    width: 330px;
    height: 390px;
    background: var(--notebook);
    border: 4px solid #111111;
    border-radius: 10px;
    left: 75px;
    top: 15px;
    transform: rotate(-5deg);
    box-shadow:
        15px 18px 0 #888888,
        0 20px 30px rgba(0, 0, 0, 0.18);
}

.notebook-cover {
    position: absolute;
    width: 100%;
    height: 55px;
    background: #111111;
    top: 0;
    left: 0;
    border-radius: 6px 6px 0 0;
}

.notebook-title {
    position: absolute;
    top: 85px;
    left: 30px;
    font-size: 27px;
    font-weight: bold;
    color: #111111;
}


/* NOTEBOOK LINES */

.line {
    position: absolute;
    left: 30px;
    width: 265px;
    height: 2px;
    background: var(--line);
}

.line1 {
    top: 145px;
}

.line2 {
    top: 185px;
}

.line3 {
    top: 225px;
}

.line4 {
    top: 265px;
}

.line5 {
    top: 305px;
}

.line6 {
    top: 345px;
}


/* NOTEBOOK SPIRAL */

.spiral {
    position: absolute;
    top: 5px;
    left: 22px;
    width: 12px;
    height: 385px;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
}

.ring {
    width: 25px;
    height: 15px;
    border: 3px solid #111111;
    border-radius: 50%;
    background: var(--notebook);
}


/* REALISTIC PEN */

.pen {
    position: absolute;
    width: 250px;
    height: 20px;
    right: 50px;
    bottom: 125px;
    transform: rotate(-42deg);
    z-index: 10;
    border-radius: 12px;

    background: linear-gradient(
        to bottom,
        #4a4a4a 0%,
        #111111 25%,
        #050505 65%,
        #2c2c2c 100%
    );

    box-shadow:
        4px 6px 8px rgba(0, 0, 0, 0.35),
        inset 0 2px 2px rgba(255, 255, 255, 0.18);
}


/* PEN HIGHLIGHT */

.pen::before {
    content: "";
    position: absolute;
    left: 55px;
    top: 3px;
    width: 120px;
    height: 3px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.35);
}


/* PEN GRIP */

.pen::after {
    content: "";
    position: absolute;
    left: 25px;
    top: 1px;
    width: 55px;
    height: 18px;
    border-radius: 10px;

    background: repeating-linear-gradient(
        90deg,
        #151515 0px,
        #151515 5px,
        #333333 6px,
        #111111 9px
    );

    box-shadow:
        inset 1px 0 rgba(255, 255, 255, 0.12),
        inset -1px 0 rgba(0, 0, 0, 0.5);
}


/* METAL PEN TIP */

.pen-tip {
    position: absolute;
    left: -30px;
    top: 1px;
    width: 35px;
    height: 18px;

    background: linear-gradient(
        to bottom,
        #eeeeee,
        #999999,
        #555555
    );

    clip-path: polygon(
        0 50%,
        100% 0,
        100% 100%
    );

    border-radius: 2px;
}


/* WRITING POINT */

.pen-tip::after {
    content: "";
    position: absolute;
    left: -4px;
    top: 7px;
    width: 8px;
    height: 4px;
    background: #222222;
    border-radius: 50%;
}


/* METAL RING */

.pen-tip::before {
    content: "";
    position: absolute;
    right: 3px;
    top: 0;
    width: 5px;
    height: 18px;
    background: #cccccc;
    border-radius: 2px;
}


/* PEN CLIP */

.pen-cap {
    position: absolute;
    right: -12px;
    top: -2px;
    width: 55px;
    height: 24px;

    background: linear-gradient(
        to bottom,
        #777777,
        #333333,
        #111111
    );

    border-radius: 4px 12px 12px 4px;

    box-shadow:
        inset 0 2px rgba(255, 255, 255, 0.25);
}


/* CLIP ARM */

.pen-cap::before {
    content: "";
    position: absolute;
    right: 8px;
    top: -18px;
    width: 7px;
    height: 40px;
    border: 3px solid #777777;
    border-left: none;
    border-radius: 0 10px 10px 0;
    transform: rotate(-8deg);
}


/* CLIP TIP */

.pen-cap::after {
    content: "";
    position: absolute;
    right: 1px;
    top: 7px;
    width: 12px;
    height: 10px;
    background: #999999;
    border-radius: 50%;
}


/* APPLICATION PAGE */

.app-panel {
    display: none;
    width: 100%;
    min-height: 100vh;
    padding: 50px;
    position: relative;
    background: var(--bg);
}

.logout {
    position: absolute;
    right: 40px;
    top: 75px;
    cursor: pointer;
    font-weight: bold;
}


/* PROFILE */

.profile {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 25px;
}

.profile-placeholder {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: var(--card);
    border: 2px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40px;
}

.profile img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
}

.app-panel h2 {
    font-size: 32px;
    margin: 0 0 10px;
}

.app-panel p {
    color: var(--secondary);
}


/* NOTEPAD */

textarea {
    width: 100%;
    height: 400px;
    border: 2px solid var(--border);
    border-radius: 7px;
    padding: 18px;
    font-size: 18px;
    resize: vertical;
    outline: none;
    background: var(--bg);
    color: var(--text);
}

textarea::placeholder {
    color: var(--secondary);
}


/* BUTTONS */

.buttons {
    display: flex;
    gap: 12px;
    margin-top: 15px;
}

.buttons button {
    flex: 1;
    padding: 14px;
    background: var(--button);
    color: var(--button-text);
    border: 2px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
    font-size: 16px;
}

.buttons button:hover {
    opacity: 0.8;
}


/* UPLOADED DOCUMENTS */

.uploaded {
    margin-top: 25px;
    background: var(--card);
    padding: 20px;
    border-radius: 8px;
}


/* MOBILE */

@media (max-width: 1000px) {

    .app {
        display: block;
    }

    .left-panel,
    .visual-panel {
        width: 100%;
        min-height: auto;
        border: none;
        padding: 40px 20px;
    }

    .visual-panel {
        min-height: 600px;
    }

    .notebook-area {
        transform: scale(0.85);
    }

    .app-panel {
        padding: 30px 20px;
    }
}


@media (max-width: 600px) {

    h1 {
        font-size: 36px;
    }

    .notebook-area {
        transform: scale(0.65);
        margin-left: -50px;
    }

    .visual-panel {
        min-height: 500px;
    }

    .buttons {
        flex-direction: column;
    }

    .theme-button {
        top: 15px;
        right: 15px;
        padding: 8px 12px;
    }

}

</style>

</head>


<body>


<!-- THEME BUTTON -->

<button
    class="theme-button"
    id="themeButton"
    onclick="toggleTheme()"
>
    🌙 Dark Mode
</button>

<!-- SAVE INDICATOR -->

<div class="save-indicator" id="saveIndicator">
    💾 Saving...
</div>


<!-- FIRST PAGE -->

<div
    class="app"
    id="firstPage"
>


    <!-- LEFT SIDE -->

    <section class="left-panel">

        <h1>
            My Notepad
        </h1>


        <p class="subtitle">
            Write your thoughts, ideas, and necessities.
        </p>


        <!-- PHOTO -->

        <div class="photo-section">

            <div
                class="photo-placeholder"
                id="photoPlaceholder"
            >
                👤
            </div>


            <img
                id="photoPreview"
                class="photo-preview"
                alt="Profile photo"
            >


            <label
                class="upload-photo"
                for="photoInput"
            >
                Upload Your Photo
            </label>


            <input
                type="file"
                id="photoInput"
                accept="image/*"
            >

        </div>


        <!-- USERNAME -->

        <input
            type="text"
            id="nameInput"
            class="name-input"
            placeholder="Enter your name"
            autocomplete="name"
        >


        <!-- DOCUMENT UPLOAD -->

        <div class="document-upload">

            <label
                class="document-label"
                for="documentInput"
            >
                📄 Upload Documents
            </label>


            <p>
                PDF, DOC, DOCX, TXT, Images and more
            </p>


            <input
                type="file"
                id="documentInput"
                multiple
                accept=".pdf,.doc,.docx,.txt,.csv,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.webp"
            >


            <div
                class="documents"
                id="loginDocuments"
            ></div>

        </div>

    </section>


    <!-- NOTEBOOK VISUAL -->

    <section class="visual-panel">

        <div class="visual-content">


            <div class="notebook-area">


                <!-- NOTEBOOK -->

                <div class="notebook">

                    <div class="notebook-cover"></div>


                    <div class="notebook-title">
                        My Notes
                    </div>


                    <div class="line line1"></div>
                    <div class="line line2"></div>
                    <div class="line line3"></div>
                    <div class="line line4"></div>
                    <div class="line line5"></div>
                    <div class="line line6"></div>


                    <!-- SPIRAL -->

                    <div class="spiral">

                        <div class="ring"></div>
                        <div class="ring"></div>
                        <div class="ring"></div>
                        <div class="ring"></div>
                        <div class="ring"></div>
                        <div class="ring"></div>
                        <div class="ring"></div>
                        <div class="ring"></div>
                        <div class="ring"></div>
                        <div class="ring"></div>

                    </div>

                </div>


                <!-- PEN -->

                <div class="pen">

                    <div class="pen-tip"></div>

                    <div class="pen-cap"></div>

                </div>


            </div>


            <h2>
                Write. Organize. Remember.
            </h2>


            <p>
                Your thoughts and necessities, all in one place.
            </p>


        </div>

    </section>

</div>


<!-- APPLICATION PAGE -->

<div
    class="app-panel"
    id="appPanel"
>


    <!-- PROFILE -->

    <div class="profile">


        <div
            class="profile-placeholder"
            id="profilePlaceholder"
        >
            👤
        </div>


        <img
            id="profileImage"
            style="display:none;"
            alt="Profile photo"
        >


        <div>

            <h2 id="welcomeMessage">
                Welcome!
            </h2>


            <p>
                Stay organized, stay productive.
            </p>

        </div>

    </div>


    <!-- LOGOUT -->

    <div
        class="logout"
        onclick="logout()"
    >
        Logout
    </div>


    <!-- NOTEPAD -->

    <textarea
        id="notepad"
        placeholder="Type your necessity here..."
    ></textarea>


    <!-- BUTTONS -->

    <div class="buttons">

        <button onclick="saveNote()">
            💾 Save
        </button>


        <button onclick="clearNote()">
            🗑 Clear
        </button>


        <button onclick="downloadNote()">
            ⬇ Download
        </button>

    </div>


    <!-- DOCUMENTS -->

    <div class="uploaded">

        <h3>
            Uploaded Documents
        </h3>


        <div
            id="appDocuments"
            class="documents"
        ></div>

    </div>

</div>


<script>


/* ============================================================================
   USER PROGRESS PERSISTENCE SYSTEM
   
   Saves the following to localStorage:
   - User name
   - Profile photo (as base64)
   - Theme preference
   - All notes
   - Uploaded documents (as base64)
   - App state (which panel is shown)
   ============================================================================ */

let selectedDocuments = [];

/* ELEMENTS */
const photoInput = document.getElementById("photoInput");
const documentInput = document.getElementById("documentInput");
const nameInput = document.getElementById("nameInput");
const notepad = document.getElementById("notepad");
const saveIndicator = document.getElementById("saveIndicator");

/* ============================================================================
   AUTO-SAVE TIMER SYSTEM
   ============================================================================ */

let saveTimeout;
let lastSavedTime = {};

function showSaveIndicator(message = "💾 Progress saved!") {
    const indicator = document.getElementById("saveIndicator");
    indicator.textContent = message;
    indicator.classList.add("show");
    
    setTimeout(() => {
        indicator.classList.remove("show");
    }, 2000);
}

function debounceAutoSave() {
    clearTimeout(saveTimeout);
    
    saveTimeout = setTimeout(() => {
        saveAllProgress();
        showSaveIndicator("💾 Progress saved!");
    }, 1000);
}

/* ============================================================================
   SAVE ALL USER PROGRESS
   ============================================================================ */

function saveAllProgress() {
    try {
        const userData = {
            name: nameInput.value,
            photo: document.getElementById("photoPreview").src || null,
            note: notepad.value,
            documents: selectedDocuments.map(doc => ({
                name: doc.name,
                data: doc.data
            })),
            theme: document.body.classList.contains("dark") ? "dark" : "light",
            appState: {
                isLoggedIn: document.getElementById("appPanel").style.display === "block"
            },
            savedAt: new Date().toISOString()
        };
        
        localStorage.setItem("userProgress", JSON.stringify(userData));
        lastSavedTime.all = new Date();
        console.log("✅ All progress saved:", userData);
        
    } catch (error) {
        console.error("❌ Error saving progress:", error);
        if (error.name === "QuotaExceededError") {
            alert("Storage limit reached. Please remove some documents.");
        }
    }
}

/* ============================================================================
   LOAD USER PROGRESS
   ============================================================================ */

function loadAllProgress() {
    try {
        const saved = localStorage.getItem("userProgress");
        if (!saved) {
            console.log("No saved progress found.");
            return;
        }
        
        const userData = JSON.parse(saved);
        console.log("✅ Progress loaded:", userData);
        
        // Restore name
        if (userData.name) {
            nameInput.value = userData.name;
        }
        
        // Restore photo
        if (userData.photo) {
            const photoPreview = document.getElementById("photoPreview");
            photoPreview.src = userData.photo;
            photoPreview.style.display = "block";
            document.getElementById("photoPlaceholder").style.display = "none";
            document.getElementById("profileImage").src = userData.photo;
            document.getElementById("profileImage").style.display = "block";
            document.getElementById("profilePlaceholder").style.display = "none";
        }
        
        // Restore theme
        if (userData.theme === "dark") {
            document.body.classList.add("dark");
            document.getElementById("themeButton").textContent = "☀️ Light Mode";
        }
        
        // Restore documents
        if (userData.documents && Array.isArray(userData.documents)) {
            selectedDocuments = userData.documents;
            displayDocuments();
        }
        
        // Restore app state (auto-login if previously logged in)
        if (userData.appState.isLoggedIn && userData.name) {
            setTimeout(() => {
                enterApp();
                if (userData.note) {
                    notepad.value = userData.note;
                }
            }, 100);
        }
        
    } catch (error) {
        console.error("❌ Error loading progress:", error);
    }
}

/* ============================================================================
   THEME MANAGEMENT
   ============================================================================ */

function loadTheme() {
    const saved = localStorage.getItem("userProgress");
    if (saved) {
        const userData = JSON.parse(saved);
        if (userData.theme === "dark") {
            document.body.classList.add("dark");
            document.getElementById("themeButton").textContent = "☀️ Light Mode";
        }
    }
}

function toggleTheme() {
    document.body.classList.toggle("dark");

    const isDark = document.body.classList.contains("dark");

    if (isDark) {
        localStorage.setItem("theme", "dark");
        document.getElementById("themeButton").textContent = "☀️ Light Mode";
    } else {
        localStorage.setItem("theme", "light");
        document.getElementById("themeButton").textContent = "🌙 Dark Mode";
    }
    
    debounceAutoSave();
}

/* ============================================================================
   PHOTO UPLOAD & SAVE
   ============================================================================ */

photoInput.addEventListener("change", function () {
    const file = this.files[0];

    if (!file) {
        return;
    }

    const reader = new FileReader();

    reader.onload = function (event) {
        document.getElementById("photoPreview").src = event.target.result;
        document.getElementById("photoPreview").style.display = "block";
        document.getElementById("photoPlaceholder").style.display = "none";
        
        document.getElementById("profileImage").src = event.target.result;
        document.getElementById("profileImage").style.display = "block";
        document.getElementById("profilePlaceholder").style.display = "none";
        
        debounceAutoSave();
    };

    reader.readAsDataURL(file);
});

/* ============================================================================
   DOCUMENT UPLOAD & SAVE
   ============================================================================ */

documentInput.addEventListener("change", function () {
    const files = Array.from(this.files);

    files.forEach(file => {
        const reader = new FileReader();

        reader.onload = function (event) {
            selectedDocuments.push({
                name: file.name,
                data: event.target.result,
                addedAt: new Date().toISOString()
            });

            displayDocuments();
            debounceAutoSave();
        };

        reader.readAsDataURL(file);
    });

    // Reset input
    documentInput.value = "";
});

/* ============================================================================
   DISPLAY DOCUMENTS
   ============================================================================ */

function displayDocuments() {
    const loginList = document.getElementById("loginDocuments");
    const appList = document.getElementById("appDocuments");

    loginList.innerHTML = "";
    appList.innerHTML = "";

    selectedDocuments.forEach((doc, index) => {
        const item = document.createElement("div");
        item.className = "document-item";

        const name = document.createElement("span");
        name.textContent = "📄 " + doc.name;

        const button = document.createElement("button");
        button.textContent = "Remove";

        button.onclick = function () {
            removeDocument(index);
        };

        item.appendChild(name);
        item.appendChild(button);

        const appItem = item.cloneNode(true);
        appItem.querySelector("button").onclick = function () {
            removeDocument(index);
        };

        loginList.appendChild(item);
        appList.appendChild(appItem);
    });
}

/* ============================================================================
   REMOVE DOCUMENT
   ============================================================================ */

function removeDocument(index) {
    selectedDocuments.splice(index, 1);
    displayDocuments();
    debounceAutoSave();
}

/* ============================================================================
   ENTER APPLICATION
   ============================================================================ */

function enterApp() {
    const name = nameInput.value.trim();

    if (name === "") {
        alert("Please enter your name.");
        nameInput.focus();
        return;
    }

    document.getElementById("firstPage").style.display = "none";
    document.getElementById("appPanel").style.display = "block";

    document.getElementById("welcomeMessage").textContent = "Welcome " + name + "!";

    document.getElementById("notepad").value = localStorage.getItem("myNote") || "";

    displayDocuments();
    
    debounceAutoSave();
}

/* ============================================================================
   KEYBOARD ENTER TO LOGIN
   ============================================================================ */

nameInput.addEventListener("keydown", function (event) {
    if (event.key === "Enter") {
        event.preventDefault();
        enterApp();
    }
});

/* ============================================================================
   SAVE NOTE
   ============================================================================ */

function saveNote() {
    const note = document.getElementById("notepad").value;

    localStorage.setItem("myNote", note);

    showSaveIndicator("💾 Note saved!");
    debounceAutoSave();
}

/* ============================================================================
   AUTO-SAVE NOTE AS USER TYPES
   ============================================================================ */

notepad.addEventListener("input", function () {
    debounceAutoSave();
});

nameInput.addEventListener("input", function () {
    debounceAutoSave();
});

/* ============================================================================
   CLEAR NOTE
   ============================================================================ */

function clearNote() {
    if (confirm("Are you sure you want to clear your note?")) {
        document.getElementById("notepad").value = "";
        debounceAutoSave();
        showSaveIndicator("📝 Note cleared!");
    }
}

/* ============================================================================
   DOWNLOAD NOTE
   ============================================================================ */

function downloadNote() {
    const note = document.getElementById("notepad").value;

    if (note.trim() === "") {
        alert("There is nothing to download.");
        return;
    }

    const file = new Blob([note], { type: "text/plain" });

    const link = document.createElement("a");

    link.href = URL.createObjectURL(file);

    link.download = "my-note.txt";

    link.click();

    URL.revokeObjectURL(link.href);
}

/* ============================================================================
   LOGOUT
   ============================================================================ */

function logout() {
    saveAllProgress();
    
    document.getElementById("appPanel").style.display = "none";
    document.getElementById("firstPage").style.display = "flex";

    nameInput.focus();
    
    showSaveIndicator("👋 Progress saved! Logged out.");
}

/* ============================================================================
   INITIALIZATION
   ============================================================================ */

loadTheme();
loadAllProgress();

// Auto-save every 30 seconds while app is open
setInterval(() => {
    if (document.getElementById("appPanel").style.display === "block") {
        saveAllProgress();
    }
}, 30000);

// Save progress before page unload
window.addEventListener("beforeunload", () => {
    saveAllProgress();
});

</script>

</body>
</html>

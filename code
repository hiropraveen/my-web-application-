<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Notepad</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: white;
            color: black;
        }

        .app {
            min-height: 100vh;
            display: flex;
        }

        .left-panel,
        .right-panel {
            width: 50%;
            padding: 50px;
        }

        .left-panel {
            border-right: 2px solid black;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .right-panel {
            display: none;
            position: relative;
        }

        h1 {
            font-size: 48px;
            margin-bottom: 10px;
        }

        h2 {
            font-size: 32px;
            margin-bottom: 10px;
        }

        p {
            font-size: 18px;
        }

        .subtitle {
            margin-bottom: 35px;
        }

        .photo-section {
            text-align: center;
            margin-bottom: 25px;
        }

        .photo-preview {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            border: 2px solid black;
            object-fit: cover;
            display: none;
            margin: auto;
        }

        .photo-placeholder {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            background: #eeeeee;
            border: 2px solid black;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 50px;
            margin: auto;
        }

        .upload-photo {
            margin-top: 15px;
            display: inline-block;
            cursor: pointer;
            font-weight: bold;
        }

        #photoInput {
            display: none;
        }

        .name-input {
            width: 100%;
            max-width: 500px;
            padding: 16px;
            background: black;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 17px;
            outline: none;
        }

        .name-input::placeholder {
            color: white;
        }

        .enter-button {
            width: 100%;
            max-width: 500px;
            padding: 16px;
            margin-top: 15px;
            background: black;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 17px;
            cursor: pointer;
        }

        .document-upload {
            width: 100%;
            max-width: 500px;
            margin-top: 25px;
            border: 2px dashed black;
            border-radius: 8px;
            padding: 30px;
            text-align: center;
        }

        #documentInput {
            display: none;
        }

        .document-label {
            cursor: pointer;
            font-weight: bold;
        }

        .documents {
            margin-top: 15px;
            width: 100%;
        }

        .document-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
            margin-top: 8px;
            background: #f2f2f2;
            border-radius: 5px;
        }

        .logout {
            position: absolute;
            right: 40px;
            top: 30px;
            cursor: pointer;
            font-weight: bold;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
        }

        .profile img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid black;
        }

        .profile-placeholder {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: #eeeeee;
            border: 2px solid black;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
        }

        textarea {
            width: 100%;
            height: 400px;
            border: 2px solid black;
            border-radius: 7px;
            padding: 18px;
            font-size: 18px;
            resize: vertical;
            outline: none;
        }

        .buttons {
            display: flex;
            gap: 12px;
            margin-top: 15px;
        }

        .buttons button {
            flex: 1;
            padding: 14px;
            background: black;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
        }

        .uploaded {
            margin-top: 25px;
            background: #f2f2f2;
            padding: 20px;
            border-radius: 8px;
        }

        @media (max-width: 900px) {
            .app {
                display: block;
            }

            .left-panel,
            .right-panel {
                width: 100%;
                border: none;
                padding: 30px 20px;
            }

            .right-panel {
                border-top: 2px solid black;
            }

            h1 {
                font-size: 36px;
            }

            .buttons {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

<div class="app">

    <section class="left-panel" id="loginPanel">

        <h1>My Notepad</h1>

        <p class="subtitle">
            Write your thoughts, ideas, and necessities.
        </p>

        <div class="photo-section">

            <div class="photo-placeholder" id="photoPlaceholder">
                👤
            </div>

            <img
                id="photoPreview"
                class="photo-preview"
                alt="Profile photo"
            >

            <label class="upload-photo" for="photoInput">
                Upload Your Photo
            </label>

            <input
                type="file"
                id="photoInput"
                accept="image/*"
            >

        </div>

        <input
            type="text"
            id="nameInput"
            class="name-input"
            placeholder="Enter your name"
        >

        <button
            class="enter-button"
            onclick="enterApp()"
        >
            Enter
        </button>

        <div class="document-upload">

            <label
                class="document-label"
                for="documentInput"
            >
                📄 Upload Documents
            </label>

            <p>
                PDF, DOC, DOCX, TXT, Images and more
            </p>

            <input
                type="file"
                id="documentInput"
                multiple
                accept=".pdf,.doc,.docx,.txt,.csv,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.webp"
            >

            <div
                class="documents"
                id="loginDocuments"
            ></div>

        </div>

    </section>


    <section class="right-panel" id="appPanel">

        <div
            class="logout"
            onclick="logout()"
        >
            Logout
        </div>

        <div class="profile">

            <div
                class="profile-placeholder"
                id="profilePlaceholder"
            >
                👤
            </div>

            <img
                id="profileImage"
                style="display:none;"
                alt="Profile photo"
            >

            <div>
                <h2 id="welcomeMessage">
                    Welcome!
                </h2>

                <p>
                    Stay organized, stay productive.
                </p>
            </div>

        </div>

        <textarea
            id="notepad"
            placeholder="Type your necessity here..."
        ></textarea>

        <div class="buttons">

            <button onclick="saveNote()">
                💾 Save
            </button>

            <button onclick="clearNote()">
                🗑 Clear
            </button>

            <button onclick="downloadNote()">
                ⬇ Download
            </button>

        </div>

        <div class="uploaded">

            <h3>Uploaded Documents</h3>

            <div
                id="appDocuments"
                class="documents"
            ></div>

        </div>

    </section>

</div>


<script>

    let selectedDocuments = [];
    let selectedPhoto = null;

    const photoInput =
        document.getElementById("photoInput");

    const documentInput =
        document.getElementById("documentInput");


    photoInput.addEventListener("change", function () {

        const file = this.files[0];

        if (!file) {
            return;
        }

        selectedPhoto = file;

        const reader = new FileReader();

        reader.onload = function (event) {

            document.getElementById(
                "photoPreview"
            ).src = event.target.result;

            document.getElementById(
                "photoPreview"
            ).style.display = "block";

            document.getElementById(
                "photoPlaceholder"
            ).style.display = "none";

            document.getElementById(
                "profileImage"
            ).src = event.target.result;

            document.getElementById(
                "profileImage"
            ).style.display = "block";

            document.getElementById(
                "profilePlaceholder"
            ).style.display = "none";
        };

        reader.readAsDataURL(file);

    });


    documentInput.addEventListener(
        "change",
        function () {

            const files = Array.from(this.files);

            selectedDocuments =
                selectedDocuments.concat(files);

            displayDocuments();

        }
    );


    function displayDocuments() {

        const loginList =
            document.getElementById(
                "loginDocuments"
            );

        const appList =
            document.getElementById(
                "appDocuments"
            );

        loginList.innerHTML = "";
        appList.innerHTML = "";

        selectedDocuments.forEach(
            function (file, index) {

                const item =
                    document.createElement("div");

                item.className =
                    "document-item";

                item.innerHTML = `
                    <span>📄 ${file.name}</span>
                    <button onclick="removeDocument(${index})">
                        Remove
                    </button>
                `;

                loginList.appendChild(
                    item.cloneNode(true)
                );

                appList.appendChild(item);

            }
        );

    }


    function removeDocument(index) {

        selectedDocuments.splice(index, 1);

        displayDocuments();

    }


    function enterApp() {

        const name =
            document.getElementById(
                "nameInput"
            ).value.trim();

        if (name === "") {

            alert("Please enter your name.");

            return;

        }

        document.getElementById(
            "loginPanel"
        ).style.display = "none";

        document.getElementById(
            "appPanel"
        ).style.display = "block";

        document.getElementById(
            "welcomeMessage"
        ).textContent =
            "Welcome " + name + "!";

        displayDocuments();

    }


    function saveNote() {

        const note =
            document.getElementById(
                "notepad"
            ).value;

        localStorage.setItem(
            "myNote",
            note
        );

        alert("Your note has been saved.");

    }


    function clearNote() {

        document.getElementById(
            "notepad"
        ).value = "";

    }


    function downloadNote() {

        const note =
            document.getElementById(
                "notepad"
            ).value;

        if (note.trim() === "") {

            alert("There is nothing to download.");

            return;

        }

        const file =
            new Blob(
                [note],
                { type: "text/plain" }
            );

        const link =
            document.createElement("a");

        link.href =
            URL.createObjectURL(file);

        link.download =
            "my-note.txt";

        link.click();

        URL.revokeObjectURL(
            link.href
        );

    }


    function logout() {

        document.getElementById(
            "appPanel"
        ).style.display = "none";

        document.getElementById(
            "loginPanel"
        ).style.display = "flex";

    }

</script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Notepad</title>
<style>
*{box-sizing:border-box} :root{--bg:#fff;--panel:#f3f3f3;--text:#000;--muted:#555;--border:#000;--card:#f2f2f2;--button:#000;--buttonText:#fff}body.dark{--bg:#111;--panel:#1c1c1c;--text:#fff;--muted:#bbb;--border:#fff;--card:#242424;--button:#fff;--buttonText:#000}body{margin:0;font-family:Arial,sans-serif;background:var(--bg);color:var(--text);transition:.3s}.theme-button{position:fixed;right:24px;top:20px;z-index:5;border:2px solid var(--border);border-radius:24px;padding:10px 16px;background:var(--button);color:var(--buttonText);cursor:pointer;font-weight:bold}.save-indicator{position:fixed;right:24px;top:70px;padding:6px 12px;border-radius:12px;background:var(--card);opacity:0;transition:opacity .3s;font-size:12px;z-index:5}.save-indicator.show{opacity:1}.app{min-height:100vh;display:flex}.left-panel,.visual-panel{width:50%;min-height:100vh;padding:50px;display:flex;flex-direction:column;align-items:center;justify-content:center}.left-panel{border-right:2px solid var(--border)}h1{font-size:48px;margin:0 0 10px}.subtitle{text-align:center;color:var(--muted);font-size:18px;margin:0 0 30px}.photo-placeholder,.photo-preview{width:130px;height:130px;border-radius:50%;border:2px solid var(--border);object-fit:cover;margin:auto}.photo-placeholder{display:flex;align-items:center;justify-content:center;background:var(--card);font-size:50px}.photo-preview{display:none}.photo-section{text-align:center;margin-bottom:24px}.upload-photo,.document-label{display:inline-block;margin-top:14px;cursor:pointer;font-weight:bold}#photoInput,#documentInput{display:none}.name-input{width:100%;max-width:500px;padding:16px;background:var(--button);color:var(--buttonText);border:2px solid var(--border);border-radius:6px;font-size:17px}.document-upload{width:100%;max-width:500px;margin-top:24px;padding:22px;border:2px dashed var(--border);border-radius:8px;text-align:center}.document-upload p{color:var(--muted)}.documents{width:100%;margin-top:12px}.document-item{display:flex;gap:10px;align-items:center;justify-content:space-between;padding:9px;margin-top:7px;background:var(--card);border-radius:5px}.document-item span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.document-item button,.buttons button,.note-list button{border:2px solid var(--border);border-radius:6px;padding:8px 12px;background:var(--button);color:var(--buttonText);cursor:pointer}.visual-panel{background:var(--panel);overflow:hidden;text-align:center}.notebook-area{width:420px;height:360px;position:relative}.notebook{position:absolute;left:70px;top:10px;width:270px;height:330px;transform:rotate(-5deg);background:#fff;border:4px solid #111;border-radius:10px;box-shadow:15px 18px #888}.notebook-cover{height:48px;background:#111;border-radius:6px 6px 0 0}.notebook-title{margin:35px 0 28px;color:#111;font-size:26px;font-weight:bold}.line{width:215px;height:2px;background:#ccc;margin:20px auto}.pen{position:absolute;width:220px;height:18px;right:20px;bottom:70px;transform:rotate(-42deg);border-radius:12px;background:linear-gradient(#555,#111,#333);box-shadow:3px 5px 8px #555}.visual-content h2{font-size:28px}.visual-content p{color:var(--muted)}.app-panel{display:none;min-height:100vh;padding:50px;background:var(--bg)}.profile{display:flex;align-items:center;gap:18px;margin-bottom:22px}.profile-placeholder,.profile img{width:90px;height:90px;border-radius:50%;border:2px solid var(--border);object-fit:cover}.profile-placeholder{display:flex;align-items:center;justify-content:center;background:var(--card);font-size:38px}.profile img{display:none}.profile h2{margin:0 0 7px}.profile p{color:var(--muted)}.logout{position:absolute;right:40px;top:75px;cursor:pointer;font-weight:bold}.workspace{display:grid;grid-template-columns:220px 1fr;gap:18px}.note-list{background:var(--card);padding:15px;border-radius:8px}.note-list h3{margin-top:0}.note-list button{width:100%;margin-bottom:8px}.note-row{display:flex;gap:5px;margin-bottom:7px}.note-row button{margin:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.note-row .delete-note{flex:0 0 auto}.editor{min-width:0}input.note-title{width:100%;padding:12px;border:2px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text);font-size:18px;margin-bottom:10px}textarea{width:100%;height:400px;padding:18px;border:2px solid var(--border);border-radius:7px;resize:vertical;background:var(--bg);color:var(--text);font-size:18px}.buttons{display:flex;gap:12px;margin-top:14px}.buttons button{flex:1}.uploaded{margin-top:24px;background:var(--card);padding:18px;border-radius:8px}.status{color:var(--muted);font-size:13px;margin-top:8px}@media(max-width:850px){.app{display:block}.left-panel,.visual-panel{width:100%;min-height:auto;padding:40px 20px}.visual-panel{min-height:500px}.app-panel{padding:30px 20px}.workspace{grid-template-columns:1fr}.logout{right:20px}.buttons{flex-direction:column}}@media(max-width:600px){h1{font-size:36px}.notebook-area{transform:scale(.75);margin-left:-45px}}
</style>
</head>
<body>
<button class="theme-button" id="themeButton" onclick="toggleTheme()">🌙 Dark Mode</button>
<div class="save-indicator" id="saveIndicator">💾 Progress saved</div>
<div class="app" id="firstPage">
<section class="left-panel">
<h1>My Notepad</h1><p class="subtitle">Write your thoughts, ideas, and necessities.</p>
<div class="photo-section"><div class="photo-placeholder" id="photoPlaceholder">👤</div><img id="photoPreview" class="photo-preview" alt="Profile photo"><label class="upload-photo" for="photoInput">Upload Your Photo</label><input type="file" id="photoInput" accept="image/*"></div>
<input class="name-input" id="nameInput" placeholder="Enter your name" autocomplete="name">
<div class="document-upload"><label class="document-label" for="documentInput">📄 Upload Documents</label><p>PDF, DOC, DOCX, TXT, images and more</p><input type="file" id="documentInput" multiple><div class="documents" id="loginDocuments"></div></div>
</section>
<section class="visual-panel"><div class="visual-content"><div class="notebook-area"><div class="notebook"><div class="notebook-cover"></div><div class="notebook-title">My Notes</div><div class="line"></div><div class="line"></div><div class="line"></div><div class="line"></div><div class="line"></div></div><div class="pen"></div></div><h2>Write. Organize. Remember.</h2><p>Your thoughts and necessities, all in one place.</p></div></section>
</div>
<div class="app-panel" id="appPanel">
<div class="profile"><div class="profile-placeholder" id="profilePlaceholder">👤</div><img id="profileImage" alt="Profile photo"><div><h2 id="welcomeMessage">Welcome!</h2><p>Stay organized, stay productive.</p></div></div>
<div class="logout" onclick="logout()">Logout</div>
<div class="workspace"><aside class="note-list"><h3>My Notes</h3><button onclick="newNote()">＋ New note</button><div id="noteList"></div></aside><main class="editor"><input class="note-title" id="noteTitle" placeholder="Note title"><textarea id="notepad" placeholder="Type your necessity here..."></textarea><div class="buttons"><button onclick="saveNote()">💾 Save draft</button><button onclick="clearNote()">🗑 Clear</button><button onclick="downloadNote()">⬇ Download</button></div><div class="status" id="noteStatus">Drafts are saved automatically in this browser.</div></main></div>
<div class="uploaded"><h3>Uploaded Documents</h3><div id="appDocuments" class="documents"></div></div>
</div>
<script>
const KEY='myNotepadProgressV2';
let state={name:'',photo:null,theme:'light',notes:[],activeNoteId:null,documents:[],loggedIn:false};
let saveTimer,indicatorTimer;
const $=id=>document.getElementById(id);
function id(){return crypto.randomUUID?crypto.randomUUID():Date.now()+'-'+Math.random()}
function saveProgress(message='💾 Progress saved'){try{state.name=$('nameInput').value.trim();state.photo=$('photoPreview').src||state.photo;state.theme=document.body.classList.contains('dark')?'dark':'light';state.loggedIn=$('appPanel').style.display==='block';localStorage.setItem(KEY,JSON.stringify({...state,savedAt:new Date().toISOString()}));showIndicator(message)}catch(e){alert('Could not save progress. Large files may exceed browser storage. Remove a document and try again.')}}
function autoSave(){clearTimeout(saveTimer);saveTimer=setTimeout(()=>saveProgress(),600)}
function showIndicator(message){$('saveIndicator').textContent=message;$('saveIndicator').classList.add('show');clearTimeout(indicatorTimer);indicatorTimer=setTimeout(()=>$('saveIndicator').classList.remove('show'),1800)}
function loadProgress(){try{const saved=JSON.parse(localStorage.getItem(KEY));if(saved)state={...state,...saved};}catch(e){localStorage.removeItem(KEY)}$('nameInput').value=state.name||'';if(state.theme==='dark'){document.body.classList.add('dark');$('themeButton').textContent='☀️ Light Mode'}if(state.photo)setPhoto(state.photo);renderDocuments();if(state.notes.length===0)createNote(false);if(state.loggedIn&&state.name)enterApp(false);else renderNoteList()}
function toggleTheme(){document.body.classList.toggle('dark');$('themeButton').textContent=document.body.classList.contains('dark')?'☀️ Light Mode':'🌙 Dark Mode';autoSave()}
function setPhoto(src){$('photoPreview').src=src;$('photoPreview').style.display='block';$('photoPlaceholder').style.display='none';$('profileImage').src=src;$('profileImage').style.display='block';$('profilePlaceholder').style.display='none'}
$('photoInput').addEventListener('change',e=>{const file=e.target.files[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{setPhoto(reader.result);state.photo=reader.result;autoSave()};reader.readAsDataURL(file)});
$('documentInput').addEventListener('change',e=>{[...e.target.files].forEach(file=>{const reader=new FileReader();reader.onload=()=>{state.documents.push({id:id(),name:file.name,type:file.type,data:reader.result});renderDocuments();autoSave()};reader.readAsDataURL(file)});e.target.value='' });
function renderDocuments(){['loginDocuments','appDocuments'].forEach(target=>{const box=$(target);if(!box)return;box.innerHTML='';state.documents.forEach(doc=>{const row=document.createElement('div');row.className='document-item';const name=document.createElement('span');name.textContent='📄 '+doc.name;const actions=document.createElement('span');const download=document.createElement('button');download.textContent='Download';download.onclick=()=>downloadFile(doc);const remove=document.createElement('button');remove.textContent='Remove';remove.onclick=()=>{state.documents=state.documents.filter(x=>x.id!==doc.id);renderDocuments();autoSave()};actions.append(download,remove);row.append(name,actions);box.append(row)})})}
function downloadFile(doc){const a=document.createElement('a');a.href=doc.data;a.download=doc.name;a.click()}
function createNote(switchTo=true){const note={id:id(),title:'Untitled note',content:'',updatedAt:new Date().toISOString()};state.notes.unshift(note);state.activeNoteId=note.id;if(switchTo){renderNoteList();loadActiveNote();autoSave('📝 New draft created')}}
function currentNote(){return state.notes.find(n=>n.id===state.activeNoteId)}
function renderNoteList(){const list=$('noteList');list.innerHTML='';state.notes.forEach(note=>{const row=document.createElement('div');row.className='note-row';const open=document.createElement('button');open.textContent=note.title||'Untitled note';open.onclick=()=>{saveEditor(false);state.activeNoteId=note.id;loadActiveNote();renderNoteList()};const del=document.createElement('button');del.className='delete-note';del.textContent='×';del.title='Delete note';del.onclick=()=>deleteNote(note.id);row.append(open,del);list.append(row)})}
function loadActiveNote(){const note=currentNote()||state.notes[0];if(!note)return;if(!state.activeNoteId)state.activeNoteId=note.id;$('noteTitle').value=note.title;$('notepad').value=note.content;$('noteStatus').textContent='Last updated: '+new Date(note.updatedAt).toLocaleString()}
function saveEditor(show=true){const note=currentNote();if(!note)return;note.title=$('noteTitle').value.trim()||'Untitled note';note.content=$('notepad').value;note.updatedAt=new Date().toISOString();renderNoteList();if(show){saveProgress('💾 Draft saved');$('noteStatus').textContent='Draft saved just now.'}}
function saveNote(){saveEditor();saveProgress('💾 Draft saved')}
function deleteNote(noteId){if(state.notes.length===1){alert('Keep at least one note.');return}if(!confirm('Delete this note?'))return;state.notes=state.notes.filter(n=>n.id!==noteId);state.activeNoteId=state.notes[0].id;loadActiveNote();renderNoteList();autoSave('🗑 Note deleted')}
function clearNote(){if(confirm('Clear this draft?')){$('notepad').value='';saveEditor(false);autoSave('📝 Draft cleared')}}
function downloadNote(){saveEditor(false);const note=currentNote();if(!note||!note.content.trim()){alert('There is nothing to download.');return}const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([note.content],{type:'text/plain'}));a.download=(note.title||'my-note')+'.txt';a.click();URL.revokeObjectURL(a.href)}
function enterApp(show=true){const name=$('nameInput').value.trim();if(!name){alert('Please enter your name.');$('nameInput').focus();return}state.name=name;state.loggedIn=true;if(show){$('firstPage').style.display='none';$('appPanel').style.display='block'}$('welcomeMessage').textContent='Welcome '+name+'!';if(state.photo)setPhoto(state.photo);renderNoteList();loadActiveNote();renderDocuments();autoSave('✅ Progress saved')}
function logout(){saveEditor(false);state.loggedIn=false;saveProgress('👋 Progress saved');$('appPanel').style.display='none';$('firstPage').style.display='flex'}
$('nameInput').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();enterApp()}});$('nameInput').addEventListener('input',autoSave);$('noteTitle').addEventListener('input',()=>{saveEditor(false);autoSave()});$('notepad').addEventListener('input',()=>{saveEditor(false);autoSave()});window.addEventListener('beforeunload',()=>{saveEditor(false);saveProgress()});
loadProgress();
</script>
</body>
</html>
